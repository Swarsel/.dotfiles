# This file is generated by OpenTofu. Do not edit manually.
# Since switching to sops-rekey, only PII files are managed here.
keys:
  - &users
    - &swarsel ${pgp_key}
%{ for name, key in users ~}
    - &${name} ${key}
%{ endfor ~}
  - &hosts
%{ for name, key in nodes ~}
    - &${name} ${key}
%{ endfor ~}
    - &buildbot ${buildbot_age_key}

creation_rules:
%{ for rule in rules ~}
  - path_regex: ${rule.path_regex}
    key_groups:
    - pgp:
      - *swarsel
%{ if length(rule.age_names) > 0 || length(users) > 0 ~}
      age:
%{ for name, _ in users ~}
      - *${name}
%{ endfor ~}
%{ for name in rule.age_names ~}
      - *${name}
%{ endfor ~}
%{ endif ~}
%{ endfor ~}
